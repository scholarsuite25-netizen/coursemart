# ==============================================================================
# COURSEMART ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy to .env for local Node/Vercel dev, or set these exact keys in:
# Vercel Dashboard -> Project ("coursemart") -> Settings -> Environment Variables
# Never commit real secret keys to Git or public/.
# ==============================================================================

# 1. GEMINI AI (Free tier - AI Article Writer & Social Post Drafts)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Optional: override the Gemini model used by the AI editor
# (defaults to gemini-4-hydrogen when unset)
GEMINI_MODEL=""

# 2. PUBLIC APP URL (Set to your Vercel domain in production, e.g. https://coursemart.vercel.app)
APP_URL="MY_APP_URL"

# 3. PAYSTACK NGN PAYMENTS (dashboard.paystack.com -> Settings -> API Keys & Webhooks)
# Supports Card, Bank Transfer, USSD, Bank App & QR in NGN (kobo)
# Set Paystack Webhook URL in dashboard to: https://<your-domain>/api/paystack/webhook
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""

# 4. EMAIL SERVICE PROVIDER (Configure EmailBump, Resend, or Brevo)
# EmailBump: https://emailbump.com/api/v1/emails (ebk_...) | Resend: 3,000/mo | Brevo: 300/day
EMAILBUMP_API_KEY=""
RESEND_API_KEY=""
BREVO_API_KEY=""
EMAIL_FROM="Coursemart <onboarding@resend.dev>"
# Optional: "emailbump" | "resend" | "brevo" (defaults to priority order above)
EMAIL_PROVIDER=""

# 5. SUPABASE POSTGRESQL & AUTH (Free tier)
# Run supabase/schema.sql in Supabase Dashboard -> SQL Editor before first production deploy.
# Accepts new keys (sb_secret_... / sb_publishable_...) OR legacy keys (service_role / anon)
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# 6. ADMIN CONSOLE & SERVER SESSION AUTH (Required in production)
# Set a strong admin password & 32+ char session secret in Vercel Environment Variables.
ADMIN_EMAIL="admin@coursemart.io"
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""

